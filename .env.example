# =========================================================
# ISALU HOSPITALS - PRODUCTION ENVIRONMENT TEMPLATE
# Copy to backend/.env on the server and fill in real values.
# Never commit the real .env to git.
# =========================================================

# --- Django core ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
ALLOWED_HOSTS=api.yourhospital.com
CSRF_TRUSTED_ORIGINS=https://yourhospital.com,https://api.yourhospital.com
CORS_ALLOWED_ORIGINS=https://yourhospital.com
CORS_ALLOW_ALL_ORIGINS=False
SECURE_SSL_REDIRECT=True

# --- Redis (shared cache and live updates between server processes) ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Email (Gmail: use an App Password, not your normal password) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=notifications@yourhospital.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Isalu Hospitals <notifications@yourhospital.com>

# --- SMS (EbulkSMS) ---
EBULKSMS_USERNAME=
EBULKSMS_API_KEY=
EBULKSMS_SENDER_ID=ISALU
EBULKSMS_API_URL=https://api.ebulksms.com/sendsms.json

# --- Security limits (defaults shown; change only if needed) ---
THROTTLE_LOGIN=10/min
THROTTLE_PUBLIC_BOOKING=30/hour
THROTTLE_PUBLIC_LOOKUP=30/min
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=7
# Turn on once HTTPS works end to end, e.g. 31536000 (one year). 0 = off.
SECURE_HSTS_SECONDS=0


# Online payment (Paystack) for private self-pay bookings.
# Private patients booking online must pay before they get a ticket.
# Get these from Paystack: Settings > API Keys & Webhooks (test keys start with sk_test_ / pk_test_)
PAYSTACK_SECRET_KEY=sk_test_PASTE_YOUR_TEST_SECRET_KEY_HERE
PAYSTACK_PUBLIC_KEY=pk_test_PASTE_YOUR_TEST_PUBLIC_KEY_HERE
# Public address of the booking website (Paystack returns patients to <this>/book)
PUBLIC_SITE_URL=https://book.isaluhospitals.com
# Private online bookings must be paid (True). False = old "pay at cashdesk" behaviour.
PRIVATE_BOOKINGS_REQUIRE_PAYMENT=True
# Minutes an unpaid online booking holds its slot
PAYMENT_HOLD_MINUTES=30
# HMO online booking for a clinic opens this many hours before it starts (closes 10 minutes before)
HMO_MIN_NOTICE_HOURS=48

# Payment Reconciliation
# Minutes between automatic checks of unconfirmed/recent online payments with Paystack (0 = off; then run
# `python manage.py reconcile_payments` from cron).
PAYMENT_SWEEP_MINUTES=15
# Patients pay this % of the clinic fee online to reschedule (0 = free).
RESCHEDULE_FEE_PERCENT=25
# Staff limits: checks (each calls Paystack) and confirmations/refunds, per staff member.
PAYMENT_RECONCILE_RATE=60/min
PAYMENT_MONEY_RATE=20/min
# Optional: accept Paystack webhooks only from these addresses (the signature is always checked).
# PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220
# Behind nginx/another proxy: True so the real caller address is recorded and checked.
TRUST_X_FORWARDED_FOR=False

# Hidden superuser bookings tools. Leave empty to switch the page off.
# Set a long random slug (24-128 letters, digits, - or _), e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The page is then at https://<your-domain>/api/<slug>/ (superusers only).
# Then on the server:
#   python manage.py set_tools_password          (the tools password)
#   python manage.py setup_tools_2fa <username>  (Google Authenticator, per superuser)
SUPERUSER_TOOLS_PATH=
# Extra addresses for the tools alert emails (superusers' own emails always get them).
SUPERUSER_TOOLS_ALERT_EMAIL=
